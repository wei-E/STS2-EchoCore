<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <CopyPckOnBuild>false</CopyPckOnBuild>
    <Sts2Dir>E:\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <BaseLibGameDllRoot>$(Sts2Dir)\mods\BaseLib.dll</BaseLibGameDllRoot>
    <BaseLibGameDllNested>$(Sts2Dir)\mods\BaseLib\BaseLib.dll</BaseLibGameDllNested>
    <BaseLibGameDllVersioned>$(Sts2Dir)\mods\BaseLib.3.1.3\BaseLib.dll</BaseLibGameDllVersioned>
    <BaseLibLocalDll>$(MSBuildThisFileDirectory)..\BaseLib-StS2\publish\BaseLib.dll</BaseLibLocalDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="EchoCore.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Steamworks.NET">
      <HintPath>$(Sts2DataDir)\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BaseLib" Condition="Exists('$(BaseLibGameDllRoot)')">
      <HintPath>$(BaseLibGameDllRoot)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BaseLib" Condition="!Exists('$(BaseLibGameDllRoot)') and Exists('$(BaseLibGameDllNested)')">
      <HintPath>$(BaseLibGameDllNested)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BaseLib" Condition="!Exists('$(BaseLibGameDllRoot)') and !Exists('$(BaseLibGameDllNested)') and Exists('$(BaseLibGameDllVersioned)')">
      <HintPath>$(BaseLibGameDllVersioned)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BaseLib" Condition="!Exists('$(BaseLibGameDllRoot)') and !Exists('$(BaseLibGameDllNested)') and !Exists('$(BaseLibGameDllVersioned)') and Exists('$(BaseLibLocalDll)')">
      <HintPath>$(BaseLibLocalDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyMod" AfterTargets="PostBuildEvent">
    <Message Text="Copying EchoCore mod files to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />

    <ItemGroup Condition="'$(CopyPckOnBuild)' == 'true'">
      <OptionalPck Include="$(MSBuildProjectDirectory)\$(MSBuildProjectName).pck" Condition="Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).pck')" />
    </ItemGroup>
    <Copy SourceFiles="@(OptionalPck)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" Condition="'$(CopyPckOnBuild)' == 'true' and '@(OptionalPck)' != ''" />
  </Target>
</Project>
